{
  "name": "dp-ring",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run v2:web:dev",
    "build": "npm run v2:web:build",
    "preview": "npm run v2:web:preview",
    "v2:web:install": "npm --prefix apps/operator-web ci",
    "v2:web:dev": "npm --prefix apps/operator-web run dev",
    "v2:web:build": "npm --prefix apps/operator-web run build",
    "v2:web:preview": "npm --prefix apps/operator-web run preview",
    "v2:web:typecheck": "npm --prefix apps/operator-web run typecheck",
    "stack:start": "node scripts/stack.mjs start",
    "stack:stop": "node scripts/stack.mjs stop",
    "stack:status": "node scripts/stack.mjs status",
    "stack:restart": "node scripts/stack.mjs restart",
    "stack:verified-start": "node scripts/start-with-regression.mjs start",
    "stack:verified-restart": "node scripts/start-with-regression.mjs restart",
    "typecheck": "npm run v2:web:typecheck",
    "lint": "eslint .",
    "test": "node scripts/regression.mjs",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test:frontend": "node scripts/run-frontend-tests.mjs",
    "test:regression": "node scripts/regression.mjs",
    "generate-session-id": "node cli-tool/generate-session-id.mjs",
    "generate-doc-basename": "node cli-tool/generate-doc-basename.mjs",
    "generate-markdown": "node cli-tool/generate-markdown.mjs",
    "ring": "node ring/cli.mjs",
    "ring:serve": "node ring/server.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.1.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.58.0",
    "vite": "8.0.3"
  }
}
