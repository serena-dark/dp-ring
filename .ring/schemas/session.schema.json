{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "session.schema.json",
  "title": "Session",
  "description": "An execution session with a proper lifecycle state machine. Links tasks, workflow runs, evaluations, and distillations.",
  "type": "object",
  "required": ["id", "type", "version", "created_at", "updated_at", "created_by", "status", "data"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^s\\d+-" },
    "type":       { "const": "session" },
    "version":    { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "session_id": {
      "type": "string",
      "description": "Self-referencing: equals own id."
    },
    "status": {
      "type": "string",
      "enum": ["gate_pending", "preparing", "executing", "reviewing", "closing", "closed", "failed"]
    },
    "data": {
      "type": "object",
      "required": ["requirement_id", "milestone_id", "task_ids", "workflow_run_ids", "execution_log"],
      "additionalProperties": false,
      "properties": {
        "requirement_id":  { "type": "string" },
        "milestone_id":    { "type": "string" },
        "milestone_ids":   { "type": "array", "items": { "type": "string" } },
        "task_ids":        { "type": "array", "items": { "type": "string" } },
        "workflow_run_ids": { "type": "array", "items": { "type": "string" } },
        "evaluation_id":   { "type": ["string", "null"] },
        "distillation_id": { "type": ["string", "null"] },
        "context_injected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workflow_template":          { "type": ["string", "null"] },
            "distillations_applied":      { "type": "array", "items": { "type": "string" }, "default": [] },
            "registry_rank_at_selection": { "type": ["integer", "null"] },
            "replanning_handoffs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task_id", "parent_task_id", "parent_decision_note"],
                "properties": {
                  "task_id": { "type": "string" },
                  "task_name": { "type": ["string", "null"] },
                  "parent_task_id": { "type": "string" },
                  "parent_decision_note": { "type": "string", "pattern": "\\S" }
                }
              },
              "default": []
            },
            "governance_selection_contexts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task_id", "workflow_template_id", "workflow_name", "selection_context"],
                "properties": {
                  "task_id": { "type": "string" },
                  "task_name": { "type": ["string", "null"] },
                  "workflow_template_id": { "type": "string" },
                  "workflow_name": { "type": "string" },
                  "selection_context": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["basis", "preferred", "compared"],
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": [
                          "governance_minimize_policy_carryover",
                          "governance_prefer_effective_force"
                        ]
                      },
                      "preferred": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["workflow_id", "workflow_name", "policy", "governance_pressure_score", "effective_force_score"],
                        "properties": {
                          "workflow_id": { "type": "string" },
                          "workflow_name": { "type": "string" },
                          "policy": { "type": "string" },
                          "governance_pressure_score": { "type": ["number", "null"] },
                          "effective_force_score": { "type": ["number", "null"] },
                          "checkpoint_id": { "type": ["string", "null"] },
                          "evidence_count": { "type": ["integer", "null"], "minimum": 0 },
                          "replay_status": { "type": ["string", "null"], "enum": ["idle", "requested", "replaying", "completed", null] },
                          "lineage_depth": { "type": ["integer", "null"], "minimum": 0 },
                          "divergence_score": { "type": ["integer", "null"], "minimum": 0 },
                          "composability_score": { "type": ["integer", "null"], "minimum": 0 }
                        }
                      },
                      "compared": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["workflow_id", "workflow_name", "policy", "governance_pressure_score", "effective_force_score"],
                        "properties": {
                          "workflow_id": { "type": "string" },
                          "workflow_name": { "type": "string" },
                          "policy": { "type": "string" },
                          "governance_pressure_score": { "type": ["number", "null"] },
                          "effective_force_score": { "type": ["number", "null"] },
                          "checkpoint_id": { "type": ["string", "null"] },
                          "evidence_count": { "type": ["integer", "null"], "minimum": 0 },
                          "replay_status": { "type": ["string", "null"], "enum": ["idle", "requested", "replaying", "completed", null] },
                          "lineage_depth": { "type": ["integer", "null"], "minimum": 0 },
                          "divergence_score": { "type": ["integer", "null"], "minimum": 0 },
                          "composability_score": { "type": ["integer", "null"], "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              },
              "default": []
            }
          },
          "default": {
            "workflow_template": null,
            "distillations_applied": [],
            "registry_rank_at_selection": null,
            "replanning_handoffs": [],
            "governance_selection_contexts": []
          }
        },
        "governance_context": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["source", "isolated_batch", "batch_signature", "reasons", "blocked_reuse"],
          "properties": {
            "source": { "const": "governance_blocked_reuse" },
            "isolated_batch": { "type": "boolean" },
            "batch_signature": { "type": "string", "minLength": 1 },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(warm_semantic_lineage|checkpoint_[a-z0-9_]+)$"
              },
              "minItems": 1
            },
            "blocked_reuse": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task_id", "workflow_template_id", "workflow_name", "reason", "detail"],
                "properties": {
                  "task_id": { "type": "string" },
                  "task_name": { "type": ["string", "null"] },
                  "workflow_template_id": { "type": "string" },
                  "workflow_name": { "type": "string" },
                  "reason": {
                    "type": "string",
                    "pattern": "^(warm_semantic_lineage|checkpoint_[a-z0-9_]+)$"
                  },
                  "checkpoint_id": { "type": ["string", "null"] },
                  "adoption_status": {
                    "enum": [null, "candidate", "mainline", "discarded", "synthesized", "archived"]
                  },
                  "branch_budget": { "type": ["integer", "null"], "minimum": 0 },
                  "workflow_tightness": { "enum": [null, "loose", "balanced", "tight"] },
                  "oversight_strength": { "enum": [null, "weak", "normal", "strong"] },
                  "detail": { "type": "string" }
                }
              }
            }
          },
          "default": null
        },
        "execution_log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "event"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "event":     { "type": "string" },
              "from":      { "type": "string" },
              "to":        { "type": "string" },
              "actor":     { "type": "string" },
              "detail":    { "type": "string" }
            }
          }
        }
      }
    }
  },
  "x-state-machine": {
    "field": "status",
    "transitions": {
      "gate_pending": ["preparing", "failed"],
      "preparing":    ["executing", "failed"],
      "executing":    ["reviewing", "failed"],
      "reviewing":    ["closing", "executing"],
      "closing":      ["closed"],
      "closed":       [],
      "failed":       ["gate_pending"]
    }
  }
}
