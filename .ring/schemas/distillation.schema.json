{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "distillation.schema.json",
  "title": "Distillation",
  "description": "Knowledge artifacts extracted from a session — lessons, patterns, anti-patterns. Confidence scores allow selection and decay.",
  "type": "object",
  "required": ["id", "type", "version", "created_at", "updated_at", "created_by", "status", "data"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^dist-" },
    "type":       { "const": "distillation" },
    "version":    { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "data": {
      "type": "object",
      "required": ["source_session_id", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "source_session_id": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "summary", "context", "applicable_when", "confidence", "source_sessions"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["lesson", "pattern", "anti-pattern", "tool-config", "prompt-template"]
              },
              "summary":         { "type": "string", "minLength": 1 },
              "context":         { "type": "string", "description": "Task type or domain this knowledge applies to." },
              "applicable_when": { "type": "string" },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Increases when reinforced across sessions; decreases on contradiction or staleness."
              },
              "source_sessions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    }
  },
  "x-state-machine": {
    "field": "status",
    "transitions": {
      "draft":     ["published"],
      "published": ["archived"],
      "archived":  ["draft"]
    }
  }
}
