{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "requirement.schema.json",
  "title": "Requirement",
  "description": "A product or user requirement with acceptance criteria and milestone references.",
  "type": "object",
  "required": ["id", "type", "version", "created_at", "updated_at", "created_by", "status", "data"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^r\\d+-" },
    "type":       { "const": "requirement" },
    "version":    { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "session_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["draft", "analyzing", "ready", "in_progress", "completed", "archived"]
    },
    "data": {
      "type": "object",
      "required": ["name", "description", "acceptance_criteria", "priority"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "satisfied"],
            "additionalProperties": false,
            "properties": {
              "id":          { "type": "string" },
              "description": { "type": "string" },
              "satisfied":   { "type": "boolean" }
            }
          }
        },
        "milestone_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
      }
    }
  },
  "x-state-machine": {
    "field": "status",
    "transitions": {
      "draft":       ["analyzing", "archived"],
      "analyzing":   ["ready", "draft"],
      "ready":       ["in_progress", "analyzing"],
      "in_progress": ["completed", "ready"],
      "completed":   ["archived"],
      "archived":    ["draft"]
    }
  }
}
