{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-run.schema.json",
  "title": "Workflow Run",
  "description": "A concrete execution of a workflow template against a specific task within a session.",
  "type": "object",
  "required": ["id", "type", "version", "created_at", "updated_at", "created_by", "status", "data"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^run-" },
    "type":       { "const": "workflow-run" },
    "version":    { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "pattern": "\\S" },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "paused", "completed", "failed", "aborted"]
    },
    "data": {
      "type": "object",
      "required": ["workflow_template_id", "workflow_template_version", "task_id", "steps", "current_step_index", "callback", "reports", "node_execution"],
      "additionalProperties": false,
      "properties": {
        "workflow_template_id":      { "type": "string", "pattern": "\\S" },
        "workflow_template_version": { "type": "integer", "minimum": 1 },
        "task_id":                   { "type": "string", "pattern": "\\S" },
        "current_step_index":        { "type": "integer", "minimum": 0 },
        "callback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "auth_scheme",
            "report_url",
            "token",
            "signing_secret",
            "signature_algorithm",
            "key_version",
            "status",
            "issued_at",
            "prepared_at",
            "last_report_at",
            "last_retry_at",
            "last_rotated_at",
            "next_retry_at",
            "report_timeout_ms",
            "max_retries",
            "retry_count",
            "retry_backoff_ms",
            "signature_ttl_ms",
            "timeout_at",
            "packet_path",
            "allowed_worker_ids",
            "accepted_protocols",
            "last_worker_id",
            "last_protocol",
            "last_error"
          ],
          "properties": {
            "auth_scheme": { "type": "string", "enum": ["bearer"] },
            "report_url": { "type": ["string", "null"], "pattern": "\\S" },
            "token": { "type": ["string", "null"], "pattern": "\\S" },
            "signing_secret": { "type": ["string", "null"], "pattern": "\\S" },
            "signature_algorithm": { "type": "string", "enum": ["hmac-sha256"] },
            "key_version": { "type": "integer", "minimum": 1 },
            "status": {
              "type": "string",
              "enum": ["pending", "active", "retry_scheduled", "completed", "failed", "timed_out"]
            },
            "issued_at": { "type": ["string", "null"], "format": "date-time" },
            "prepared_at": { "type": ["string", "null"], "format": "date-time" },
            "last_report_at": { "type": ["string", "null"], "format": "date-time" },
            "last_retry_at": { "type": ["string", "null"], "format": "date-time" },
            "last_rotated_at": { "type": ["string", "null"], "format": "date-time" },
            "next_retry_at": { "type": ["string", "null"], "format": "date-time" },
            "report_timeout_ms": { "type": "integer", "minimum": 1 },
            "max_retries": { "type": "integer", "minimum": 0 },
            "retry_count": { "type": "integer", "minimum": 0 },
            "retry_backoff_ms": { "type": "integer", "minimum": 1 },
            "signature_ttl_ms": { "type": "integer", "minimum": 1 },
            "timeout_at": { "type": ["string", "null"], "format": "date-time" },
            "packet_path": { "type": ["string", "null"], "pattern": "\\S" },
            "allowed_worker_ids": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
            "accepted_protocols": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
            "last_worker_id": { "type": ["string", "null"], "pattern": "\\S" },
            "last_protocol": { "type": ["string", "null"], "pattern": "\\S" },
            "last_error": { "type": ["string", "null"], "pattern": "\\S" }
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "status", "actor", "authenticated"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "status": { "type": "string" },
              "actor": { "type": "string", "pattern": "\\S" },
              "step_id": { "type": ["string", "null"], "pattern": "\\S" },
              "note": { "type": ["string", "null"], "pattern": "\\S" },
              "commit_sha": { "type": ["string", "null"], "pattern": "\\S" },
              "worker_id": { "type": ["string", "null"], "pattern": "\\S" },
              "protocol": { "type": ["string", "null"], "pattern": "\\S" },
              "authenticated": { "type": "boolean" },
              "outputs": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "replanning_status": {
                        "enum": [null, "pending", "awaiting_replan", "redispatched", "terminal"]
                      },
                      "branch_budget": { "type": ["integer", "null"], "minimum": 0 }
                    }
                  }
                ]
              }
            }
          }
        },
        "node_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "branch_id",
            "active_checkpoint_id",
            "checkpoint_ids",
            "branch_event_ids",
            "capsule_state"
          ],
          "properties": {
            "node_id": { "type": ["string", "null"], "pattern": "\\S" },
            "branch_id": { "type": "string", "pattern": "\\S" },
            "active_checkpoint_id": { "type": ["string", "null"], "pattern": "\\S" },
            "checkpoint_ids": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
            "branch_event_ids": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
            "capsule_state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "node_id",
                "lease",
                "heartbeat",
                "runtime_status",
                "current_checkpoint_id",
                "last_checkpoint_at",
                "last_evidence_at",
                "last_accepted_evidence_refs",
                "replay",
                "journal"
              ],
              "properties": {
                "schema_version": { "type": "string", "minLength": 1 },
                "node_id": { "type": ["string", "null"], "pattern": "\\S" },
                "lease": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["holder", "expires_at", "acquired_at", "renewed_at", "released_at", "fence_token"],
                  "properties": {
                    "holder": { "type": ["string", "null"], "pattern": "\\S" },
                    "expires_at": { "type": ["string", "null"], "format": "date-time" },
                    "acquired_at": { "type": ["string", "null"], "format": "date-time" },
                    "renewed_at": { "type": ["string", "null"], "format": "date-time" },
                    "released_at": { "type": ["string", "null"], "format": "date-time" },
                    "fence_token": { "type": "integer", "minimum": 0 }
                  }
                },
                "heartbeat": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["recorded_at", "detail"],
                  "properties": {
                    "recorded_at": { "type": ["string", "null"], "format": "date-time" },
                    "detail": { "type": ["object", "null"] }
                  }
                },
                "runtime_status": { "type": "string", "minLength": 1 },
                "current_checkpoint_id": { "type": ["string", "null"], "pattern": "\\S" },
                "last_checkpoint_at": { "type": ["string", "null"], "format": "date-time" },
                "last_evidence_at": { "type": ["string", "null"], "format": "date-time" },
                "last_accepted_evidence_refs": { "type": "array", "items": { "type": ["object", "string"] } },
                "replay": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "requested_at",
                    "completed_at",
                    "requested_by",
                    "reason",
                    "source_checkpoint_id",
                    "target_checkpoint_id",
                    "cursor",
                    "journal_state"
                  ],
                  "properties": {
                    "status": { "type": "string", "enum": ["idle", "requested", "replaying", "completed"] },
                    "requested_at": { "type": ["string", "null"], "format": "date-time" },
                    "completed_at": { "type": ["string", "null"], "format": "date-time" },
                    "requested_by": { "type": ["string", "null"], "pattern": "\\S" },
                    "reason": { "type": ["string", "null"] },
                    "source_checkpoint_id": { "type": ["string", "null"], "pattern": "\\S" },
                    "target_checkpoint_id": { "type": ["string", "null"], "pattern": "\\S" },
                    "cursor": { "type": ["object", "string", "null"] },
                    "journal_state": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["mode", "last_applied_entry_id", "pending_entry_ids"],
                      "properties": {
                        "mode": { "type": "string", "minLength": 1 },
                        "last_applied_entry_id": { "type": ["string", "null"], "pattern": "\\S" },
                        "pending_entry_ids": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
                      }
                    }
                  }
                },
                "journal": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["timestamp", "event"],
                    "additionalProperties": true,
                    "properties": {
                      "timestamp": { "type": "string", "format": "date-time" },
                      "event": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_id", "status"],
            "additionalProperties": false,
            "properties": {
              "step_id":    { "type": "string", "pattern": "\\S" },
              "status":     { "type": "string", "enum": ["pending", "running", "completed", "failed", "skipped"] },
              "started_at": { "type": ["string", "null"], "format": "date-time" },
              "ended_at":   { "type": ["string", "null"], "format": "date-time" },
              "outputs":    { "type": "object", "default": {} },
              "notes":      { "type": ["string", "null"], "pattern": "\\S" }
            }
          }
        }
      }
    }
  },
  "x-state-machine": {
    "field": "status",
    "transitions": {
      "pending":   ["running"],
      "running":   ["paused", "completed", "failed"],
      "paused":    ["running", "aborted"],
      "completed": [],
      "failed":    ["pending"],
      "aborted":   []
    }
  }
}
