{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "title": "Task",
  "description": "A unit of work derived from a requirement milestone, bound to a workflow template.",
  "type": "object",
  "required": ["id", "type", "version", "created_at", "updated_at", "created_by", "status", "data"],
  "additionalProperties": false,
  "properties": {
    "id":         { "type": "string", "pattern": "^t\\d+-" },
    "type":       { "const": "task" },
    "version":    { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "session_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "in_progress", "completed", "failed", "cancelled"]
    },
    "data": {
      "type": "object",
      "required": ["name", "description", "task_type", "requirement_id", "milestone_id", "acceptance_criteria"],
      "additionalProperties": false,
      "properties": {
        "name":           { "type": "string", "minLength": 1 },
        "description":    { "type": "string" },
        "task_type": {
          "type": "string",
          "description": "Category used for workflow registry lookup. Examples: feature-implementation, bug-fix, refactoring, documentation, testing, infrastructure."
        },
        "requirement_id":        { "type": "string" },
        "milestone_id":          { "type": "string" },
        "workflow_template_id":  { "type": ["string", "null"] },
        "workflow_run_id":       { "type": ["string", "null"] },
        "execution_mode":        { "type": ["string", "null"], "enum": ["serial", "parallel", null] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_type", "target_path", "repo_root", "file_paths"],
          "properties": {
            "target_type": { "type": "string", "enum": ["project", "module", "file"] },
            "target_path": { "type": "string", "minLength": 1 },
            "repo_root":   { "type": "string", "minLength": 1 },
            "file_paths": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judge_agent_id",
            "review_status",
            "completion_commit_sha",
            "changed_files",
            "scope_match",
            "build_required",
            "build_command",
            "build_status",
            "cleanup_paths",
            "cleanup_status",
            "merge_status",
            "summary_path",
            "review_packet",
            "failure_feedback_id",
            "failure_distillation_id",
            "completion_distillation_id",
            "last_error",
            "checked_at",
            "reviewed_at",
            "note"
          ],
          "properties": {
            "judge_agent_id": { "type": ["string", "null"] },
            "review_status": {
              "type": "string",
              "enum": [
                "pending",
                "verifying_scope",
                "scope_failed",
                "build_failed",
                "cleanup_failed",
                "workflow_failed",
                "workflow_timeout",
                "awaiting_judgement",
                "approved",
                "rejected"
              ]
            },
            "completion_commit_sha": { "type": ["string", "null"] },
            "changed_files": { "type": "array", "items": { "type": "string" } },
            "scope_match": { "type": ["boolean", "null"] },
            "build_required": { "type": "boolean" },
            "build_command": { "type": ["string", "null"] },
            "build_status": { "type": "string", "enum": ["pending", "passed", "failed", "skipped"] },
            "cleanup_paths": { "type": "array", "items": { "type": "string" } },
            "cleanup_status": { "type": "string", "enum": ["pending", "completed", "failed", "skipped"] },
            "merge_status": { "type": "string", "enum": ["blocked", "ready"] },
            "summary_path": { "type": ["string", "null"] },
            "review_packet": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["agent_id", "subject", "body", "dispatched_at"],
              "properties": {
                "agent_id": { "type": "string" },
                "subject": { "type": "string" },
                "body": { "type": "string" },
                "dispatched_at": { "type": "string", "format": "date-time" }
              }
            },
            "failure_feedback_id": { "type": ["string", "null"] },
            "failure_distillation_id": { "type": ["string", "null"] },
            "completion_distillation_id": { "type": ["string", "null"] },
            "last_error": { "type": ["string", "null"] },
            "checked_at": { "type": ["string", "null"], "format": "date-time" },
            "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
            "note": { "type": ["string", "null"] }
          }
        },
        "replanning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replanner_agent_id",
            "status",
            "source_failure",
            "packet",
            "successor_task_id",
            "parent_task_id",
            "decision_note",
            "reviewed_at"
          ],
          "properties": {
            "replanner_agent_id": { "type": ["string", "null"] },
            "status": {
              "type": "string",
              "enum": ["pending", "awaiting_replan", "redispatched", "terminal"]
            },
            "source_failure": {
              "enum": [
                null,
                "scope_mismatch",
                "build_failed",
                "cleanup_failed",
                "workflow_failed",
                "workflow_timeout",
                "review_rejected"
              ]
            },
            "packet": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["agent_id", "subject", "body", "dispatched_at"],
              "properties": {
                "agent_id": { "type": "string" },
                "subject": { "type": "string" },
                "body": { "type": "string" },
                "dispatched_at": { "type": "string", "format": "date-time" }
              }
            },
            "successor_task_id": { "type": ["string", "null"] },
            "parent_task_id": { "type": ["string", "null"] },
            "parent_decision_note": { "type": ["string", "null"] },
            "decision_note": { "type": ["string", "null"] },
            "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "satisfied"],
            "additionalProperties": false,
            "properties": {
              "id":          { "type": "string" },
              "description": { "type": "string" },
              "satisfied":   { "type": "boolean" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": {
                    "enum": ["pending", "verifying_scope", "awaiting_judgement", "approved"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": null }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "scope_failed" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "scope_mismatch" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "build_failed" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "build_failed" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "cleanup_failed" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "cleanup_failed" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "workflow_failed" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "workflow_failed" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "workflow_timeout" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "workflow_timeout" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["execution", "replanning"],
            "properties": {
              "execution": {
                "required": ["review_status"],
                "properties": {
                  "review_status": { "const": "rejected" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["source_failure"],
                "properties": {
                  "source_failure": { "const": "review_rejected" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": { "const": "pending" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["packet"],
                "properties": {
                  "packet": { "const": null }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["awaiting_replan", "redispatched", "terminal"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["packet"],
                "properties": {
                  "packet": { "type": "object" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": { "const": "redispatched" }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["successor_task_id"],
                "properties": {
                  "successor_task_id": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["pending", "awaiting_replan", "terminal"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["successor_task_id"],
                "properties": {
                  "successor_task_id": { "const": null }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["parent_task_id"],
                "properties": {
                  "parent_task_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["parent_decision_note"],
                "properties": {
                  "parent_decision_note": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["pending", "awaiting_replan"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["decision_note"],
                "properties": {
                  "decision_note": { "const": null }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["pending", "awaiting_replan"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["reviewed_at"],
                "properties": {
                  "reviewed_at": { "const": null }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["redispatched", "terminal"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["reviewed_at"],
                "properties": {
                  "reviewed_at": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["replanning"],
            "properties": {
              "replanning": {
                "required": ["status"],
                "properties": {
                  "status": {
                    "enum": ["redispatched", "terminal"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "replanning": {
                "required": ["decision_note"],
                "properties": {
                  "decision_note": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "x-state-machine": {
    "field": "status",
    "transitions": {
      "pending":     ["ready", "cancelled"],
      "ready":       ["in_progress", "cancelled"],
      "in_progress": ["completed", "failed"],
      "completed":   [],
      "failed":      ["pending"],
      "cancelled":   []
    }
  }
}
